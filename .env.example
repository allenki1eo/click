# Mwongozo Proxy — Environment Variables
# Copy this file to proxy/.env and fill in your values

# ── AI Provider (at least one required) ────────────────────────────────────

# Anthropic (RECOMMENDED for desktop Computer Use + screen vision)
# When set:
#   • /detect  → Claude Computer Use API for precise UI element coordinates
#   • /chat    → Claude directly (no OpenRouter markup) when model=claude-*
# Get a key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter: fallback for Claude + 200+ other models via one key
# Used when ANTHROPIC_API_KEY is not set or model is not claude-*
OPENROUTER_API_KEY=sk-or-...

# BigModel.cn: for GLM-5V-Turbo (cheaper vision option)
BIGMODEL_API_KEY=

# ── Voice Services ──────────────────────────────────────────────────────────
# ElevenLabs: high-quality text-to-speech (supports Swahili voices)
ELEVENLABS_API_KEY=
# Voice ID: use ElevenLabs voice library to find a suitable Swahili voice
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# AssemblyAI: speech-to-text transcription
ASSEMBLYAI_API_KEY=

# ── Security ────────────────────────────────────────────────────────────────
# Admin secret: protects /admin/* endpoints from public access
# Set this to a strong random string in production
# Leave empty in development (admin endpoints are open)
ADMIN_SECRET=

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8787

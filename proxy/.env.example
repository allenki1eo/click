# Mwongozo Proxy Environment Variables
# Copy this file to .env and fill in your API keys

# AI Provider API Keys (at least one required)

# Option 1: OpenRouter API Key (for Claude, Llama, etc.)
# Get one at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Option 2: BigModel API Key (for GLM-5V-Turbo and other Zhipu AI models)
# Get one at: https://open.bigmodel.cn/
BIGMODEL_API_KEY=your_bigmodel_api_key_here

# ElevenLabs API Key (for text-to-speech)
# Get one at: https://elevenlabs.io/app/settings/api
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs Voice ID (optional - defaults to Rachel)
# Find voices at: https://elevenlabs.io/app/voice-lab
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# AssemblyAI API Key (for voice transcription)
# Get one at: https://www.assemblyai.com/app
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
